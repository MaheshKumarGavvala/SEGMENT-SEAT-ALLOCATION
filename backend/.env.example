PORT=3000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=smart_segment_app
DB_PASSWORD=CHANGE_THIS_PASSWORD
DB_NAME=smart_segment

# If your Ubuntu MySQL root account uses auth_socket, you can instead use:
# DB_USER=root
# DB_PASSWORD=
# DB_SOCKET=/var/run/mysqld/mysqld.sock

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Google sign-in (create a Web application OAuth client in Google Cloud)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://segment-seat-allocation.onrender.com/api/auth/google/callback
FRONTEND_LOGIN_URL=https://maheshkumargavvala.github.io/SEGMENT-SEAT-ALLOCATION/auth/auth/login/login.html
